reject_rows("0 on 40 0.7${padding}  ")
reject_rows("0 on 40 0.7\n${dense}0 reset 0 0\n")

run_probe(2 "")
run_probe(2 "" --unknown 48000 --frames 1)
run_probe(2 "" --sample-rate 48000 --frames)
run_probe(2 "" --sample-rate 48000 --sample-rate 48000)
foreach(rate IN ITEMS nan inf -inf 31999.999999999996 192000.00000000003 1e999 48000junk)
    run_probe(2 "" --sample-rate "${rate}" --frames 1)
endforeach()
foreach(frames IN ITEMS 0 4097 -1 1.5 999999999999999999999)
    run_probe(2 "" --sample-rate 48000 --frames "${frames}")
endforeach()

file(REMOVE_RECURSE "${work}")
message(STATUS "PASS bounded double-precision audio probe, analytic initial voltage, ordering, reset, and rejection")
