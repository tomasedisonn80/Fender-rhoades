cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED PROGRAM OR NOT IS_ABSOLUTE "${PROGRAM}" OR NOT EXISTS "${PROGRAM}"
        OR IS_DIRECTORY "${PROGRAM}" OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "PROGRAM must be an absolute executable path; TEST_ROOT is required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${TEST_ROOT}/audio-probe-${suffix}")
file(MAKE_DIRECTORY "${work}")

function(run_probe expected input)
    file(WRITE "${work}/events.txt" "${input}")
    execute_process(COMMAND "${PROGRAM}" ${ARGN} INPUT_FILE "${work}/events.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE probe_json ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Probe expected exit ${expected}, received ${result}: ${diagnostic}")
    endif()
    if(expected EQUAL 0)
        if(NOT "${diagnostic}" STREQUAL "")
            message(FATAL_ERROR "Probe success emitted diagnostics: ${diagnostic}")
        endif()
        string(JSON root ERROR_VARIABLE error TYPE "${probe_json}")
        if(NOT "${error}" STREQUAL "NOTFOUND" OR NOT root STREQUAL "OBJECT")
            message(FATAL_ERROR "Probe success must contain one JSON object: ${error}")
        endif()
    elseif(NOT "${probe_json}" STREQUAL "" OR NOT diagnostic MATCHES "^rhodes_audio_probe:")
        message(FATAL_ERROR "Probe rejection must have empty stdout and a diagnostic")
    endif()
    set(probe_json "${probe_json}" PARENT_SCOPE)
endfunction()

function(json_read output expected_type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${probe_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND" OR NOT actual_type STREQUAL expected_type)
        message(FATAL_ERROR "JSON [${ARGN}] must be ${expected_type}: ${error}")
    endif()
    string(JSON value GET "${probe_json}" ${ARGN})
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(json_expect expected_type expected)
    json_read(actual "${expected_type}" ${ARGN})
    if(expected_type STREQUAL "NUMBER")
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
        endif()
    elseif(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
    endif()
endfunction()

function(expect_silence)
    json_read(samples ARRAY samples_volts)
    string(REGEX REPLACE "[0, \t\r\n]" "" nonzero "${samples}")
    if(NOT nonzero STREQUAL "[]")
        message(FATAL_ERROR "Silent probe produced nonzero samples")
    endif()
endfunction()

execute_process(COMMAND "${PROGRAM}" --help RESULT_VARIABLE result
    OUTPUT_VARIABLE help ERROR_VARIABLE diagnostic TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL ""
        OR NOT help MATCHES "4096 rows" OR NOT help MATCHES "128 bytes"
        OR NOT help MATCHES "17 significant digits" OR NOT help MATCHES "64-frame blocks")
    message(FATAL_ERROR "Missing bounded-probe help contract: ${help}${diagnostic}")
endif()

run_probe(0 "" --sample-rate 32000 --frames 4096)
json_expect(NUMBER 1 schema_version)
json_expect(STRING synthetic-filtered-audio model)
json_expect(NUMBER 4096 frames)
json_expect(NUMBER 0 event_count)
json_expect(NUMBER 48 latency_frames)
json_read(scope STRING scope)
if(NOT scope MATCHES "Uncalibrated synthetic loaded-harp voltage"
        OR NOT scope MATCHES "no gain, normalization, time shift")
    message(FATAL_ERROR "Probe must state its synthetic, unscaled scope")
endif()
string(JSON count LENGTH "${probe_json}" samples_volts)
if(NOT count EQUAL 4096)
    message(FATAL_ERROR "Probe must retain exactly the requested frame count")
endif()
expect_silence()

# Double-valued rate boundaries, including immediately adjacent binary64 values.
set(rates 32000 44100.5 48000 48000.00000000001 96000 96000.00000000001 192000)
set(factors 4 4 4 2 2 1 1)
set(internal_rates 128000 176402 192000 96000.000000000015 192000 96000.00000000001 192000)
foreach(index RANGE 0 6)
    list(GET rates ${index} rate)
    list(GET factors ${index} factor)
    list(GET internal_rates ${index} internal_rate)
    run_probe(0 "" --sample-rate "${rate}" --frames 1)
    json_expect(NUMBER "${rate}" sample_rate_hz)
    json_expect(NUMBER "${internal_rate}" internal_sample_rate_hz)
    json_expect(NUMBER "${factor}" oversampling_factor)
    json_expect(NUMBER 48 latency_frames)
    expect_silence()
endforeach()

# Independent t=0 closed form: initial loaded voltage is
# -0.4 * (0.06*0.7*(1+0.3*0.45+0.08*0.2)) / 3 /
# (1 + 200*(0.25+23/3)/1e6). Multiply by h[0] from the documented
# normalized Kaiser-sinc recipe, evaluated separately with an I0 power series.
# These bounds do not read production coefficients or run ResearchEngine.
# The narrow first-sample bounds also detect float32 conversion or added gain.
set(strike_rates 48000 96000 192000)
set(first_lower 3.59140679364e-9 7.18282098868e-9 1.43656870106e-8)
set(first_upper 3.59140679366e-9 7.18282098871e-9 1.43656870107e-8)
foreach(index RANGE 0 2)
    list(GET strike_rates ${index} rate)
    list(GET first_lower ${index} lower)
    list(GET first_upper ${index} upper)
    run_probe(0 "0 on 40 0.7\n" --sample-rate "${rate}" --frames 129)
    json_read(first NUMBER samples_volts 0)
    if(first LESS lower OR first GREATER upper)
        message(FATAL_ERROR "Independent first sample mismatch at ${rate} Hz: ${first}")
    endif()
endforeach()

run_probe(0 "0 on 40 0.7\n" --sample-rate 48000 --frames 129)
json_read(baseline ARRAY samples_volts)
set(baseline_json "${probe_json}")
# More than 256 events at one offset are legal for this physical-event exporter.
string(REPEAT "0 sustain 0 0\n" 4095 dense)
run_probe(0 "0 on 40 0.7\n${dense}" --sample-rate 48000 --frames 129)
json_expect(NUMBER 4096 event_count)
json_read(dense_samples ARRAY samples_volts)
if(NOT "${dense_samples}" STREQUAL "${baseline}")
    message(FATAL_ERROR "Dense same-offset events changed sample values or ordering")
endif()

run_probe(0 "0 on 40 0.3\n0 reset 0 0\n0 on 40 0.7\n" --sample-rate 48000 --frames 129)
json_read(ordered ARRAY samples_volts)
if(NOT "${ordered}" STREQUAL "${baseline}")
    message(FATAL_ERROR "Same-offset reset then on did not preserve producer order")
endif()
run_probe(0 "0 on 40 0.7\n0 reset 0 0\n" --sample-rate 48000 --frames 129)
expect_silence()

# Reset at the 64-frame boundary must flush FIR history and preserve causal time.
run_probe(0 "0 on 1 0.8\n63 sustain 0 1\n64 reset 0 0\n64 on 40 0.7\n"
    --sample-rate 48000 --frames 129)
foreach(index RANGE 0 64)
    math(EXPR shifted "${index} + 64")
    string(JSON expected GET "${baseline_json}" samples_volts ${index})
    json_read(actual NUMBER samples_volts ${shifted})
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Reset sample ${shifted} differs from unshifted baseline ${index}")
    endif()
endforeach()

# Valid alternate option order, CRLF, whitespace, and final unterminated row.
run_probe(0 "\t0 on 40 0.7\r\n1 off 40 0\n1 sustain 0 1\n2 all_off 0 0\n2 reset 0 0"
    --frames 3 --sample-rate 48000)
json_expect(NUMBER 5 event_count)
string(REPEAT " " 116 padding)
run_probe(0 "0 on 40 0.7${padding} " --sample-rate 48000 --frames 1)
json_expect(NUMBER 1 event_count)

function(reject_rows rows)
    run_probe(2 "${rows}" --sample-rate 48000 --frames 129)
endfunction()
reject_rows("\n")
