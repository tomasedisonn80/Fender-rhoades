cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED BENCHMARK OR NOT IS_ABSOLUTE "${BENCHMARK}"
        OR NOT EXISTS "${BENCHMARK}" OR IS_DIRECTORY "${BENCHMARK}")
    message(FATAL_ERROR "BENCHMARK must name an existing absolute executable path")
endif()

# Only printable ASCII is accepted by this CLI. Quotes, backslashes and spaces
# still require correct JSON escaping and a lossless process-argument round trip.
set(machine_label "cmake \"quote\" \\backslash with spaces")

function(json_read output expected_type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${benchmark_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND"
            OR NOT "${actual_type}" STREQUAL "${expected_type}")
        message(FATAL_ERROR "JSON [${ARGN}] must be ${expected_type}: ${error}")
    endif()
    string(JSON value ERROR_VARIABLE error GET "${benchmark_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Cannot read JSON [${ARGN}]: ${error}")
    endif()
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(json_expect expected_type expected)
    json_read(actual "${expected_type}" ${ARGN})
    if("${expected_type}" STREQUAL "NUMBER")
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
        endif()
    elseif(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "JSON [${ARGN}] differs from its expected value")
    endif()
endfunction()

function(json_length output)
    string(JSON length ERROR_VARIABLE error LENGTH "${benchmark_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Cannot read JSON length [${ARGN}]: ${error}")
    endif()
    set("${output}" "${length}" PARENT_SCOPE)
endfunction()

function(check_summary begin end)
    math(EXPR count "${end} - ${begin}")
    if(count EQUAL 0)
        json_read(empty NULL ${ARGN})
        return()
    endif()
    json_read(summary OBJECT ${ARGN})
    json_expect(NUMBER "${count}" ${ARGN} observations)
    # 64 frames / 32000 Hz is exactly 2000 microseconds. Count observed overruns;
    # no machine-speed limit or expected number of misses is imposed.
    json_expect(NUMBER 2000 ${ARGN} deadline_us)
    list(SUBLIST raw_values ${begin} ${count} window)
    list(GET window 0 minimum)
    set(maximum "${minimum}")
    set(misses 0)
    foreach(value IN LISTS window)
        if(value LESS 0)
            message(FATAL_ERROR "Negative callback duration")
        endif()
        if(value LESS minimum)
            set(minimum "${value}")
        endif()
        if(value GREATER maximum)
            set(maximum "${value}")
        endif()
        if(value GREATER 2000)
            math(EXPR misses "${misses} + 1")
        endif()
    endforeach()
    json_expect(NUMBER "${maximum}" ${ARGN} max_us)
    json_expect(NUMBER "${misses}" ${ARGN} deadline_misses)
    json_read(mean NUMBER ${ARGN} mean_us)
    if(mean LESS minimum OR mean GREATER maximum)
        message(FATAL_ERROR "Mean lies outside its observations")
    endif()
    # Independently check nearest-rank quantiles by counting observations on
    # either side, including ties. CMake math(EXPR) is integer-only; do not
    # truncate floating durations or rely on lexicographic list sorting.
    foreach(percent IN ITEMS 50 95 99)
        json_read(quantile NUMBER ${ARGN} "p${percent}_us")
        math(EXPR rank "(${count} * ${percent} + 99) / 100")
        set(below 0)
        set(at_or_below 0)
        foreach(value IN LISTS window)
            if(value LESS quantile)
                math(EXPR below "${below} + 1")
            endif()
            if(value LESS_EQUAL quantile)
                math(EXPR at_or_below "${at_or_below} + 1")
            endif()
        endforeach()
        if(NOT below LESS rank OR at_or_below LESS rank)
            message(FATAL_ERROR "Incorrect nearest-rank p${percent} in [${ARGN}]")
        endif()
    endforeach()
    if(count EQUAL 1)
        json_expect(NUMBER "${minimum}" ${ARGN} mean_us)
    endif()
endfunction()

function(run_case workload offsets blocks keys initial on off sustain)
    execute_process(COMMAND "${BENCHMARK}" --blocks "${blocks}" --block-size 64
        --sample-rate 32000 --active-keys "${keys}" --warmup-blocks 2
        --workload "${workload}" --offsets "${offsets}" --machine "${machine_label}"
        RESULT_VARIABLE result OUTPUT_VARIABLE benchmark_json ERROR_VARIABLE diagnostic
        TIMEOUT 30)
    if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
        message(FATAL_ERROR "${workload}/${offsets} failed: ${result}: ${diagnostic}")
    endif()
    json_read(root OBJECT)
    json_expect(NUMBER 2 schema_version)
    json_expect(STRING synthetic_event_processor benchmark)
    json_expect(BOOLEAN ON complete)
    json_expect(STRING "${machine_label}" environment machine_label)
    json_expect(STRING "${workload}" workload id)
    json_expect(STRING "${offsets}" workload offset_policy)
    json_expect(NUMBER 32000 workload sample_rate_hz)
    json_expect(NUMBER 64 workload block_frames)
    json_expect(NUMBER "${blocks}" workload requested_blocks)
    json_expect(NUMBER "${blocks}" workload measured_blocks)
    json_expect(NUMBER "${keys}" workload selected_key_count)
    json_expect(NUMBER 2 workload warmup_blocks_completed)
    json_expect(NUMBER 2 workload warmup_blocks_attempted)
    json_expect(BOOLEAN ON workload warmup_excluded)
    json_expect(BOOLEAN ON workload reset_before_measurement)
    json_expect(NUMBER "${initial}" workload initial_condition_events_excluded)
    json_expect(NUMBER "${on}" workload timed_event_counts note_on)
    json_expect(NUMBER "${off}" workload timed_event_counts note_off)
    json_expect(NUMBER "${sustain}" workload timed_event_counts sustain)
    json_expect(NUMBER 0 workload timed_event_counts all_notes_off)
    json_expect(NUMBER 0 workload timed_event_counts reset)
    json_expect(BOOLEAN ON integrity finite_output_and_checksum)
    json_expect(NUMBER "${blocks}" integrity status_counts ok)
    foreach(status IN ITEMS invalid_input arithmetic_fault reset_required)
        json_expect(NUMBER 0 integrity status_counts "${status}")
    endforeach()
    json_read(failure NULL integrity last_failure_sample)
    json_expect(STRING "nearest rank" timing percentile_method)
    json_length(raw_count timing raw_callback_us)
    if(NOT raw_count EQUAL blocks)
        message(FATAL_ERROR "Raw timing count differs from measured blocks")
    endif()
    math(EXPR last "${raw_count} - 1")
    set(raw_values)
    foreach(index RANGE 0 ${last})
        json_read(value NUMBER timing raw_callback_us "${index}")
        list(APPEND raw_values "${value}")
    endforeach()
    check_summary(0 ${blocks} timing summary)
    json_length(quarters timing consecutive_quarter_windows)
    if(NOT quarters EQUAL 4)
        message(FATAL_ERROR "Expected four chronological windows")
    endif()
    foreach(quarter RANGE 0 3)
        math(EXPR begin "${blocks} * ${quarter} / 4")
        math(EXPR end "${blocks} * (${quarter} + 1) / 4")
        json_expect(NUMBER "${begin}" timing consecutive_quarter_windows "${quarter}" begin_block)
        json_expect(NUMBER "${end}" timing consecutive_quarter_windows "${quarter}" end_block_exclusive)
        check_summary(${begin} ${end} timing consecutive_quarter_windows "${quarter}" summary)
    endforeach()
    if("${workload}" STREQUAL "silence")
        json_expect(NUMBER 0 integrity checksum_sum_squares)
        json_expect(NUMBER 0 integrity peak_abs_synthetic_volts)
    endif()
endfunction()

# Event totals exclude the two warmup calls and any one-frame initialization.
run_case(retrigger256 distributed 5 2 0 640 640 0)
run_case(retrigger256 same        5 2 0 640 640 0)
run_case(pedal256     distributed 5 2 5 0 0 1280)
run_case(pedal256     same        5 2 5 0 0 1280)
run_case(silence      distributed 101 0 0 0 0 0)
run_case(silence      same        1 0 0 0 0 0)
run_case(chord        distributed 5 2 0 2 0 0)
run_case(tail-held    distributed 5 2 2 0 0 0)
run_case(tail-sustained distributed 5 2 5 0 0 0)
run_case(tail-release distributed 5 2 4 0 0 0)

function(expect_rejected)
    execute_process(COMMAND "${BENCHMARK}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "2" OR NOT "${output}" STREQUAL ""
            OR NOT diagnostic MATCHES "^rhodes_runtime_benchmark:")
        message(FATAL_ERROR "Invalid arguments [${ARGN}] did not reject cleanly: ${result}: ${diagnostic}")
    endif()
endfunction()

expect_rejected(--blocks 0)
expect_rejected(--blocks 1000001)
expect_rejected(--blocks -1)
expect_rejected(--blocks 1junk)
expect_rejected(--blocks)
expect_rejected(--block-size 0)
expect_rejected(--block-size 4097)
expect_rejected(--sample-rate 31999)
expect_rejected(--sample-rate 192001)
expect_rejected(--sample-rate nan)
expect_rejected(--active-keys 74)
expect_rejected(--active-keys 0 --workload retrigger256)
expect_rejected(--warmup-blocks 10001)
expect_rejected(--workload unknown)
expect_rejected(--offsets unknown)
expect_rejected(--unknown 1)
string(ASCII 31 control_character)
expect_rejected(--machine "bad${control_character}label")

message(STATUS "Runtime benchmark: 10 workload/JSON cases and 17 invalid-input cases passed")
