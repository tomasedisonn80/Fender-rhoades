cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED PROGRAM OR NOT IS_ABSOLUTE "${PROGRAM}"
        OR NOT EXISTS "${PROGRAM}" OR IS_DIRECTORY "${PROGRAM}")
    message(FATAL_ERROR "PROGRAM must name an existing absolute executable path")
endif()
if(DEFINED BASELINE_PROGRAM AND (NOT IS_ABSOLUTE "${BASELINE_PROGRAM}"
        OR NOT EXISTS "${BASELINE_PROGRAM}" OR IS_DIRECTORY "${BASELINE_PROGRAM}"))
    message(FATAL_ERROR "BASELINE_PROGRAM must name an existing absolute pre-change executable")
endif()

# Self-contained opt-in schema checks. The optional baseline executable enables
# an actual pre-change/current byte comparison without platform-specific goldens.
function(run_cli output)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE result_json ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
        message(FATAL_ERROR "Contact CLI [${ARGN}] failed: ${result}: ${diagnostic}")
    endif()
    set("${output}" "${result_json}" PARENT_SCOPE)
endfunction()

function(json_read output expected_type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${contact_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND" OR NOT "${actual_type}" STREQUAL "${expected_type}")
        message(FATAL_ERROR "JSON [${ARGN}] must be ${expected_type}: ${error}")
    endif()
    string(JSON value ERROR_VARIABLE error GET "${contact_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Cannot read JSON [${ARGN}]: ${error}")
    endif()
    if("${expected_type}" STREQUAL "NUMBER")
        string(TOLOWER "${value}" lowered)
        if(lowered MATCHES "nan|inf")
            message(FATAL_ERROR "Nonfinite JSON number [${ARGN}]")
        endif()
    endif()
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(json_expect expected_type expected)
    json_read(actual "${expected_type}" ${ARGN})
    if("${expected_type}" STREQUAL "NUMBER")
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
        endif()
    elseif(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
    endif()
endfunction()

run_cli(default_json --fixture conservative_impact --output-step 0.001)
set(contact_json "${default_json}")
string(JSON ignored ERROR_VARIABLE error TYPE "${contact_json}" runs 0 diagnostics located_peak_candidates)
if("${error}" STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Default mode must omit located_peak_candidates entirely")
endif()
json_expect(NUMBER 1 schema_version)
json_expect(BOOLEAN ON runs 0 success)
json_read(old_scope STRING runs 0 diagnostics sampled_maxima scope)
if(NOT old_scope MATCHES "not continuous-time extrema")
    message(FATAL_ERROR "Legacy sampled-maxima coverage must remain unchanged")
endif()

run_cli(contact_json --fixture conservative_impact --output-step 0.001 --locate-peak-candidates)
run_cli(reordered_json --locate-peak-candidates --fixture conservative_impact --output-step 0.001)
if(NOT "${contact_json}" STREQUAL "${reordered_json}")
    message(FATAL_ERROR "The valueless opt-in flag must be independent of option order")
endif()
json_expect(NUMBER 1 schema_version)
json_expect(BOOLEAN ON runs 0 success)
json_expect(NUMBER 0 runs 0 failure_code)
set(path runs 0 diagnostics located_peak_candidates)
json_read(candidates OBJECT ${path})
json_expect(STRING uncertified_sign_change_search ${path} coverage)
json_expect(STRING fixed_interval_anchor_replay_two_rk4_half_steps_or_certified_free_motion
    ${path} evaluation_method)
foreach(contact IN ITEMS hammer damper)
    foreach(quantity IN ITEMS compression force)
        if(quantity STREQUAL "compression")
            set(value_key value_m)
        else()
            set(value_key value_n)
        endif()
        set(record ${path} "${contact}_${quantity}")
        json_read(record_object OBJECT ${record})
        json_read(value NUMBER ${record} "${value_key}")
        json_read(time NUMBER ${record} time_s)
        json_read(begin NUMBER ${record} bracket_lo_s)
        json_read(end NUMBER ${record} bracket_hi_s)
        json_read(origin STRING ${record} origin)
        if(value LESS 0 OR begin LESS 0 OR time LESS begin OR end LESS time OR end GREATER 0.002)
            message(FATAL_ERROR "Invalid SI value or time bracket for ${contact}_${quantity}")
        endif()
        if(NOT origin MATCHES "^(disabled|sample|stationary_candidate|action_before|action_after)$")
            message(FATAL_ERROR "Unrecognized peak origin: ${origin}")
        endif()
        if(contact STREQUAL "hammer")
            json_expect(STRING stationary_candidate ${record} origin)
            # Independent two-free-mass elastic maximum at pi/(2*sqrt(k/mu)).
            if(time LESS 0.00044427 OR time GREATER 0.00044431)
                message(FATAL_ERROR "Elastic maximum time outside independent analytic interval")
            endif()
            if(quantity STREQUAL "compression")
                if(value LESS 0.0002828426 OR value GREATER 0.0002828429)
                    message(FATAL_ERROR "Elastic compression maximum outside analytic interval")
                endif()
            elseif(value LESS 5.656852 OR value GREATER 5.656857)
                message(FATAL_ERROR "Elastic force maximum outside analytic interval")
            endif()
        else()
            json_expect(NUMBER 0 ${record} "${value_key}")
            json_expect(STRING disabled ${record} origin)
        endif()
    endforeach()
endforeach()

# Additive diagnostics must not change these pre-existing exported records.
foreach(field IN ITEMS samples events relaunch_snapshots)
    string(JSON before GET "${default_json}" runs 0 "${field}")
    string(JSON after GET "${contact_json}" runs 0 "${field}")
    if(NOT "${before}" STREQUAL "${after}")
        message(FATAL_ERROR "Peak collection changed exported ${field}")
    endif()
endforeach()
string(JSON before GET "${default_json}" runs 0 diagnostics sampled_maxima)
string(JSON after GET "${contact_json}" runs 0 diagnostics sampled_maxima)
if(NOT "${before}" STREQUAL "${after}")
    message(FATAL_ERROR "Peak collection changed legacy sampled maxima")
endif()

run_cli(contact_json --fixture grazing_tangent --locate-peak-candidates --output-step 0.001)
json_expect(BOOLEAN ON runs 0 success)
foreach(quantity IN ITEMS compression force)
    if(quantity STREQUAL "compression")
        set(value_key value_m)
    else()
        set(value_key value_n)
    endif()
    json_expect(NUMBER 0 ${path} "hammer_${quantity}" "${value_key}")
    json_expect(STRING sample ${path} "hammer_${quantity}" origin)
endforeach()

execute_process(COMMAND "${PROGRAM}" --locate-peak-candidates false
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
if(NOT "${result}" STREQUAL "1" OR NOT "${output}" STREQUAL ""
        OR NOT diagnostic MATCHES "^Contact reference error:")
    message(FATAL_ERROR "The opt-in flag must not consume an unexpected value")
endif()

if(DEFINED BASELINE_PROGRAM)
    foreach(fixture IN ITEMS conservative_impact damped_impact forced_clamp supported_impact
            moving_damper evolved_relaunch grazing_tangent)
        execute_process(COMMAND "${BASELINE_PROGRAM}" --fixture "${fixture}"
            RESULT_VARIABLE result OUTPUT_VARIABLE baseline ERROR_VARIABLE diagnostic TIMEOUT 30)
        if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
            message(FATAL_ERROR "Pre-change ${fixture} failed: ${result}: ${diagnostic}")
        endif()
        run_cli(current --fixture "${fixture}")
        if(NOT "${current}" STREQUAL "${baseline}")
            string(SHA256 baseline_hash "${baseline}")
            string(SHA256 current_hash "${current}")
            message(FATAL_ERROR "Default ${fixture} changed bytes: ${baseline_hash} -> ${current_hash}")
        endif()
    endforeach()
    message(STATUS "Contact peaks: seven default fixtures byte-identical to supplied pre-change executable")
endif()
message(STATUS "Contact peaks: default omission, opt-in schema, analytic values, zero origins and legacy records passed")
