# Q6-specific exporter/renderer contracts. No Python or audio-reader dependency.
# Keep failed fixtures for inspection; never modify legacy CLI fixtures.
cmake_minimum_required(VERSION 3.24)
foreach(argument IN ITEMS PROBE RENDERER)
    if(NOT DEFINED ${argument} OR NOT IS_ABSOLUTE "${${argument}}"
            OR NOT EXISTS "${${argument}}" OR IS_DIRECTORY "${${argument}}")
        message(FATAL_ERROR "${argument} must name an absolute executable path")
    endif()
endforeach()
if(NOT DEFINED TEST_ROOT OR NOT IS_ABSOLUTE "${TEST_ROOT}" OR NOT IS_DIRECTORY "${TEST_ROOT}")
    message(FATAL_ERROR "TEST_ROOT must name an existing absolute directory")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${TEST_ROOT}/quadrature-cli-${suffix}")
file(MAKE_DIRECTORY "${work}")
set_property(GLOBAL PROPERTY qcli_probe_calls 0)
set_property(GLOBAL PROPERTY qcli_render_calls 0)
set_property(GLOBAL PROPERTY qcli_wav_frames 0)

function(json_expect expected_type expected)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${probe_json}" ${ARGN})
    if(NOT error STREQUAL "NOTFOUND" OR NOT actual_type STREQUAL expected_type)
        message(FATAL_ERROR "JSON [${ARGN}] must be ${expected_type}: ${error}")
    endif()
    string(JSON value GET "${probe_json}" ${ARGN})
    if(expected_type STREQUAL "NUMBER")
        if(NOT value EQUAL expected)
            message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${value}")
        endif()
    elseif(NOT value STREQUAL expected)
        message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${value}")
    endif()
endfunction()

function(run_probe expected input)
    file(WRITE "${work}/events.txt" "${input}")
    execute_process(COMMAND "${PROBE}" ${ARGN} INPUT_FILE "${work}/events.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE probe_json ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Probe expected ${expected}, received ${result}: ${diagnostic}")
    endif()
    get_property(calls GLOBAL PROPERTY qcli_probe_calls)
    math(EXPR calls "${calls} + 1")
    set_property(GLOBAL PROPERTY qcli_probe_calls "${calls}")
    if(expected EQUAL 0)
        if(NOT diagnostic STREQUAL "")
            message(FATAL_ERROR "Successful probe emitted diagnostics: ${diagnostic}")
        endif()
        json_expect(NUMBER 1 schema_version)
        json_expect(STRING synthetic-quadrature-audio model)
        json_expect(NUMBER 6 quadrature_nodes)
        json_expect(STRING gauss-legendre-host-cell observation_scheme)
        json_expect(NUMBER 48 latency_frames)
        foreach(forbidden IN ITEMS oversampling_factor internal_sample_rate_hz)
            string(JSON ignored ERROR_VARIABLE error TYPE "${probe_json}" "${forbidden}")
            if(error STREQUAL "NOTFOUND")
                message(FATAL_ERROR "Q6 must not report uniform sampling field ${forbidden}")
            endif()
        endforeach()
        string(JSON frames GET "${probe_json}" frames)
        string(JSON count LENGTH "${probe_json}" samples_volts)
        if(NOT count EQUAL frames)
            message(FATAL_ERROR "Probe sample count differs from its frame count")
        endif()
    elseif(NOT probe_json STREQUAL "" OR NOT diagnostic MATCHES "^rhodes_quadrature_probe:")
        message(FATAL_ERROR "Probe rejection must have empty stdout and a quadrature diagnostic")
    endif()
    set(probe_json "${probe_json}" PARENT_SCOPE)
endfunction()

function(expect_silence)
    string(JSON samples GET "${probe_json}" samples_volts)
    string(REGEX REPLACE "[0, \t\r\n]" "" remaining "${samples}")
    if(NOT remaining STREQUAL "[]")
        message(FATAL_ERROR "Expected exactly silent quadrature output")
    endif()
endfunction()

execute_process(COMMAND "${PROBE}" --help RESULT_VARIABLE result
    OUTPUT_VARIABLE help ERROR_VARIABLE diagnostic TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT diagnostic STREQUAL ""
        OR NOT help MATCHES "rhodes_quadrature_probe" OR NOT help MATCHES "Six Gauss-Legendre"
        OR NOT help MATCHES "4096 rows" OR NOT help MATCHES "128 bytes")
    message(FATAL_ERROR "Missing quadrature help/limit contract: ${help}${diagnostic}")
endif()

run_probe(0 "" --sample-rate 32000 --frames 4096)
json_expect(NUMBER 4096 frames)
json_expect(NUMBER 0 event_count)
expect_silence()

# Exact decimal round trips include both sides of the old 48/96 kHz factors.
# Raw-field checks do not let a numeric comparison collapse adjacent doubles.
foreach(rate IN ITEMS 32000 44100 44100.5 48000 48000.000000000007
        64000 88200 96000 96000.000000000015 192000)
    run_probe(0 "0 on 40 0.7\n" --sample-rate "${rate}" --frames 2)
    string(FIND "${probe_json}" "\"sample_rate_hz\":${rate}," rate_position)
    if(rate_position LESS 0)
        message(FATAL_ERROR "Probe changed the exact host rate ${rate}: ${probe_json}")
    endif()
    json_expect(NUMBER 2 frames)
    json_expect(NUMBER 1 event_count)
    json_expect(NUMBER 0 samples_volts 0)
    string(JSON second GET "${probe_json}" samples_volts 1)
    if(second EQUAL 0)
        message(FATAL_ERROR "Second output frame must contain the first completed cell at ${rate} Hz")
    endif()
endforeach()

run_probe(0 "0 on 40 0.7\n" --sample-rate 48000 --frames 129)
set(baseline_json "${probe_json}")
string(JSON baseline GET "${probe_json}" samples_volts)
run_probe(0 "0 on 0 0.5\n0 reset 0 0\n0 on 40 0.7\n" --sample-rate 48000 --frames 129)
string(JSON ordered GET "${probe_json}" samples_volts)
if(NOT ordered STREQUAL baseline)
    message(FATAL_ERROR "Same-offset reset then strike changed the fresh trajectory")
endif()
run_probe(0 "0 on 40 0.7\n0 reset 0 0\n" --sample-rate 48000 --frames 129)
expect_silence()
run_probe(0 "0 on 0 1\n63 sustain 0 1\n64 reset 0 0\n64 on 40 0.7\n"
    --sample-rate 48000 --frames 129)
foreach(index RANGE 0 64)
    math(EXPR shifted "${index} + 64")
    string(JSON expected GET "${baseline_json}" samples_volts ${index})
    string(JSON actual GET "${probe_json}" samples_volts ${shifted})
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Boundary reset retained prior history or shifted frame ${shifted}")
    endif()
endforeach()

# Physical exporter capacity is 4096 rows, including more than 256 at one offset.
string(REPEAT "0 sustain 0 0\n" 4095 dense)
run_probe(0 "0 on 40 0.7\n${dense}" --sample-rate 48000 --frames 129)
json_expect(NUMBER 4096 event_count)
string(JSON dense_samples GET "${probe_json}" samples_volts)
if(NOT dense_samples STREQUAL baseline)
    message(FATAL_ERROR "Dense physical events changed the quadrature trajectory")
endif()
set(row "0 on 40 0.7")
string(LENGTH "${row}" row_bytes)
math(EXPR padding_bytes "128 - ${row_bytes}")
string(REPEAT " " ${padding_bytes} padding)
run_probe(0 "${row}${padding}" --sample-rate 48000 --frames 1)
json_expect(NUMBER 1 event_count)
run_probe(0 "\t0 on 40 0.7\r\n1 off 40 0\n1 sustain 0 1\n2 reset 0 0"
    --frames 3 --sample-rate 48000)
json_expect(NUMBER 4 event_count)

foreach(rows IN ITEMS "${row}${padding} " "${row}\n${dense}0 reset 0 0\n"
        "0 on 40 0.7\n128 reset 0 nan\n" "0 on 40 inf\n" "0 on 40 -inf\n"
        "0 on 40 0.7 extra\n" "0 on 73 0.7\n" "129 on 40 0.7\n"
        "2 on 40 0.7\n1 off 40 0\n" "0 sustain 0 0.5\n" "0 unknown 0 0\n" "\n")
    run_probe(2 "${rows}" --sample-rate 48000 --frames 129)
endforeach()
foreach(rate IN ITEMS nan inf -inf 31999.999999999996 192000.00000000003 1e999 48000junk)
    run_probe(2 "" --sample-rate "${rate}" --frames 1)
endforeach()
foreach(frames IN ITEMS 0 4097 -1 1.5)
    run_probe(2 "" --sample-rate 48000 --frames "${frames}")
endforeach()
run_probe(2 "" --sample-rate 48000 --sample-rate 48000)
run_probe(2 "" --unknown 48000 --frames 1)

function(run_render expected destination)
    execute_process(COMMAND "${RENDERER}" --output "${destination}" --seconds 0.01
            --sample-rate 48000 --audio-path quadrature ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Renderer expected ${expected}, received ${result}: ${output}${diagnostic}")
    endif()
    get_property(calls GLOBAL PROPERTY qcli_render_calls)
    math(EXPR calls "${calls} + 1")
    set_property(GLOBAL PROPERTY qcli_render_calls "${calls}")
    if(expected EQUAL 0)
        if(NOT diagnostic STREQUAL "" OR NOT output MATCHES "audio-path=quadrature, quadrature nodes=6 per host cell, host rate="
                OR NOT output MATCHES ", latency=48 frames" OR output MATCHES "internal rate="
                OR NOT output MATCHES "Synthetic parameters; no hardware fidelity result")
            message(FATAL_ERROR "Incorrect quadrature renderer metadata: ${output}${diagnostic}")
        endif()
    elseif(NOT output STREQUAL "" OR NOT diagnostic MATCHES "^rhodes_render:")
        message(FATAL_ERROR "Renderer rejection must emit no success output")
    endif()
    set(render_stdout "${output}" PARENT_SCOPE)
endfunction()

function(read_u32 output byte_offset)
    math(EXPR offset "2 * ${byte_offset}")
    foreach(index RANGE 0 3)
        math(EXPR position "${offset} + 2 * ${index}")
        string(SUBSTRING "${wav_hex}" ${position} 2 byte_${index})
    endforeach()
    math(EXPR value "0x${byte_3}${byte_2}${byte_1}${byte_0}")
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(assert_wav path rate frames silent)
    file(READ "${path}" wav_hex HEX)
    file(SIZE "${path}" actual_bytes)
    math(EXPR data_bytes "4 * ${frames}")
    math(EXPR expected_bytes "58 + ${data_bytes}")
    math(EXPR riff_bytes "50 + ${data_bytes}")
    math(EXPR byte_rate "4 * ${rate}")
    string(SUBSTRING "${wav_hex}" 0 8 riff)
    string(SUBSTRING "${wav_hex}" 16 32 format)
    string(SUBSTRING "${wav_hex}" 64 28 extension)
    string(SUBSTRING "${wav_hex}" 100 8 data)
    if(NOT actual_bytes EQUAL expected_bytes OR NOT riff STREQUAL "52494646"
            OR NOT format STREQUAL "57415645666d74201200000003000100"
            OR NOT extension STREQUAL "0400200000006661637404000000" OR NOT data STREQUAL "64617461")
        message(FATAL_ERROR "Incorrect IEEE-float WAV container: ${path}")
    endif()
    set(offsets 4 24 28 46 54)
    set(expected_values "${riff_bytes}" "${rate}" "${byte_rate}" "${frames}" "${data_bytes}")
    foreach(index RANGE 0 4)
        list(GET offsets ${index} offset)
        list(GET expected_values ${index} expected)
        read_u32(actual ${offset})
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "WAV field ${offset}: expected ${expected}, found ${actual}")
        endif()
    endforeach()
    read_u32(first 58)
    if(NOT first EQUAL 0)
        message(FATAL_ERROR "Q6 WAV must retain its zero first causal sample")
    endif()
    set(nonzero FALSE)
    math(EXPR last_frame "${frames} - 1")
    foreach(frame RANGE 0 ${last_frame})
        math(EXPR offset "58 + 4 * ${frame}")
        read_u32(bits ${offset})
        math(EXPR exponent "(${bits} >> 23) & 255")
        math(EXPR magnitude "${bits} & 2147483647")
        if(exponent EQUAL 255)
            message(FATAL_ERROR "Nonfinite binary32 WAV sample at ${frame}")
        endif()
        if(NOT magnitude EQUAL 0)
            set(nonzero TRUE)
        endif()
    endforeach()
    if((silent AND nonzero) OR (NOT silent AND NOT nonzero))
        message(FATAL_ERROR "Incorrect WAV silence/excitation result: ${path}")
    endif()
    get_property(checked GLOBAL PROPERTY qcli_wav_frames)
    math(EXPR checked "${checked} + ${frames}")
    set_property(GLOBAL PROPERTY qcli_wav_frames "${checked}")
endfunction()

execute_process(COMMAND "${RENDERER}" --help RESULT_VARIABLE result
    OUTPUT_VARIABLE help ERROR_VARIABLE diagnostic TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT diagnostic STREQUAL ""
        OR NOT help MATCHES "direct\\|filtered\\|quadrature"
        OR NOT help MATCHES "6 fractional observations per host cell")
    message(FATAL_ERROR "Missing quadrature renderer help: ${help}${diagnostic}")
endif()
foreach(rate IN ITEMS 32000 48000 192000)
    set(destination "${work}/quadrature ${rate}.wav")
    run_render(0 "${destination}" --sample-rate "${rate}")
    math(EXPR frames "${rate} / 100")
    assert_wav("${destination}" "${rate}" "${frames}" FALSE)
    if(NOT render_stdout MATCHES "host rate=${rate} Hz")
        message(FATAL_ERROR "Renderer host rate does not match requested rate")
    endif()
endforeach()
set(destination "${work}/quadrature 48000.wav")
file(SHA256 "${destination}" original_hash)
run_render(2 "${destination}" --gain 0)
file(SHA256 "${destination}" refused_hash)
run_render(2 "${destination}" --gain nan --force)
file(SHA256 "${destination}" invalid_hash)
if(NOT refused_hash STREQUAL original_hash OR NOT invalid_hash STREQUAL original_hash)
    message(FATAL_ERROR "Rejected quadrature render changed the existing file")
endif()
run_render(0 "${destination}" --gain 0 --force)
assert_wav("${destination}" 48000 480 TRUE)
foreach(rate IN ITEMS 31999 192001 48000.5 nan inf)
    set(rejected "${work}/rejected-${rate}.wav")
    run_render(2 "${rejected}" --sample-rate "${rate}")
    if(EXISTS "${rejected}" OR IS_SYMLINK "${rejected}")
        message(FATAL_ERROR "Invalid-rate render published an output")
    endif()
endforeach()
run_render(2 "${work}/missing-parent/note.wav")
if(EXISTS "${work}/missing-parent")
    message(FATAL_ERROR "Renderer created an output parent unexpectedly")
endif()

set(marker "Preserve this entry and every byte.\n")
file(MAKE_DIRECTORY "${work}/directory.wav")
file(WRITE "${work}/directory.wav/marker" "${marker}")
run_render(2 "${work}/directory.wav" --force)
file(READ "${work}/directory.wav/marker" observed)
if(NOT observed STREQUAL marker)
    message(FATAL_ERROR "Directory rejection changed its contents")
endif()
foreach(kind IN ITEMS live dangling)
    set(target "${work}/${kind}-target.wav")
    set(link "${work}/${kind}-link.wav")
    if(kind STREQUAL "live")
        file(WRITE "${target}" "${marker}")
    endif()
    file(CREATE_LINK "${target}" "${link}" SYMBOLIC RESULT link_result)
    if(NOT "${link_result}" STREQUAL "0")
        message(STATUS "SKIP ${kind} symlink rejection: ${link_result}")
        continue()
    endif()
    file(READ_SYMLINK "${link}" original_target)
    run_render(2 "${link}")
    run_render(2 "${link}" --force)
    if(NOT IS_SYMLINK "${link}")
        message(FATAL_ERROR "Quadrature renderer replaced the ${kind} symlink")
    endif()
    file(READ_SYMLINK "${link}" observed_target)
    if(NOT observed_target STREQUAL original_target)
        message(FATAL_ERROR "Quadrature renderer changed the ${kind} symlink target")
    endif()
    if(kind STREQUAL "live")
        file(READ "${target}" observed)
        if(NOT observed STREQUAL marker)
            message(FATAL_ERROR "Quadrature renderer changed the live target bytes")
        endif()
    elseif(EXISTS "${target}" OR IS_SYMLINK "${target}")
        message(FATAL_ERROR "Quadrature renderer created the dangling target")
    endif()
endforeach()
file(GLOB leftovers LIST_DIRECTORIES true "${work}/.rhodes-render-*")
if(leftovers)
    message(FATAL_ERROR "Quadrature renderer left temporary outputs: ${leftovers}")
endif()
get_property(probe_calls GLOBAL PROPERTY qcli_probe_calls)
get_property(render_calls GLOBAL PROPERTY qcli_render_calls)
get_property(wav_frames GLOBAL PROPERTY qcli_wav_frames)
file(REMOVE_RECURSE "${work}")
message(STATUS "PASS quadrature CLI: ${probe_calls} probe calls, ${render_calls} renderer calls, ${wav_frames} finite WAV frames; help, timing, limits, and publication")
