cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED BENCHMARK OR NOT IS_ABSOLUTE "${BENCHMARK}"
        OR NOT EXISTS "${BENCHMARK}" OR IS_DIRECTORY "${BENCHMARK}")
    message(FATAL_ERROR "BENCHMARK must name an existing absolute executable path")
endif()

set(machine_label "cmake \"quote\" \\backslash with spaces")
set(successful_cases 0)
set(rejected_cases 0)

function(json_read output expected_type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${benchmark_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND"
            OR NOT "${actual_type}" STREQUAL "${expected_type}")
        message(FATAL_ERROR "JSON [${ARGN}] must be ${expected_type}: ${error}")
    endif()
    string(JSON value ERROR_VARIABLE error GET "${benchmark_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Cannot read JSON [${ARGN}]: ${error}")
    endif()
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(json_expect expected_type expected)
    json_read(actual "${expected_type}" ${ARGN})
    if("${expected_type}" STREQUAL "NUMBER")
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
        endif()
    elseif(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "JSON [${ARGN}] differs from its expected value")
    endif()
endfunction()

function(check_summary blocks frames)
    string(JSON raw_count ERROR_VARIABLE error LENGTH "${benchmark_json}" timing raw_callback_us)
    if(NOT "${error}" STREQUAL "NOTFOUND" OR NOT raw_count EQUAL blocks)
        message(FATAL_ERROR "Raw timing count differs from measured callbacks")
    endif()
    math(EXPR last "${raw_count} - 1")
    set(raw_values)
    foreach(index RANGE 0 ${last})
        json_read(value NUMBER timing raw_callback_us "${index}")
        if(value LESS 0)
            message(FATAL_ERROR "Negative callback duration")
        endif()
        list(APPEND raw_values "${value}")
    endforeach()

    # The test uses 32 kHz: each frame lasts exactly 31.25 microseconds.
    # Form the exact decimal using integer arithmetic, without rounding timings.
    math(EXPR quarter_microseconds "${frames} * 125")
    math(EXPR whole "${quarter_microseconds} / 4")
    math(EXPR fraction "(${quarter_microseconds} % 4) * 25")
    set(deadline "${whole}.${fraction}")
    json_expect(NUMBER "${deadline}" timing summary deadline_us)
    json_expect(NUMBER "${blocks}" timing summary observations)
    list(GET raw_values 0 maximum)
    set(misses 0)
    foreach(value IN LISTS raw_values)
        if(value GREATER maximum)
            set(maximum "${value}")
        endif()
        if(value GREATER deadline)
            math(EXPR misses "${misses} + 1")
        endif()
    endforeach()
    json_expect(NUMBER "${maximum}" timing summary max_us)
    json_expect(NUMBER "${misses}" timing summary deadline_misses)
    json_read(mean NUMBER timing summary mean_us)
    if(mean LESS 0)
        message(FATAL_ERROR "Negative mean duration")
    endif()
    if(blocks EQUAL 1)
        json_expect(NUMBER "${maximum}" timing summary mean_us)
    endif()

    # Count values on each side of the reported quantile. This independently
    # verifies the nearest rank, including ties, without lexicographic sorting
    # or conversion of fractional durations to integer microseconds.
    foreach(percent IN ITEMS 50 95 99)
        json_read(quantile NUMBER timing summary "p${percent}_us")
        math(EXPR rank "(${blocks} * ${percent} + 99) / 100")
        set(below 0)
        set(at_or_below 0)
        foreach(value IN LISTS raw_values)
            if(value LESS quantile)
                math(EXPR below "${below} + 1")
            endif()
            if(value LESS_EQUAL quantile)
                math(EXPR at_or_below "${at_or_below} + 1")
            endif()
        endforeach()
        if(NOT below LESS rank OR at_or_below LESS rank)
            message(FATAL_ERROR "Incorrect nearest-rank p${percent}")
        endif()
    endforeach()
endfunction()

function(run_case fingerprint workload format blocks frames keys warmup)
    execute_process(COMMAND "${BENCHMARK}" --blocks "${blocks}" --block-size "${frames}"
        --sample-rate 32000 --active-keys "${keys}" --warmup-blocks "${warmup}"
        --workload "${workload}" --sample-format "${format}" --machine "${machine_label}"
        RESULT_VARIABLE result OUTPUT_VARIABLE benchmark_json ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
        message(FATAL_ERROR "${workload}/${format} failed: ${result}: ${diagnostic}")
    endif()
    json_read(root OBJECT)
    json_expect(NUMBER 1 schema_version)
    json_expect(STRING synthetic_vst3_process benchmark)
    json_expect(BOOLEAN ON complete)
    json_expect(STRING "${machine_label}" environment machine_label)
    json_expect(STRING "${workload}" workload id)
    json_expect(NUMBER "${format}" workload sample_format_bits)
    json_expect(NUMBER 32000 workload sample_rate_hz)
    json_expect(NUMBER "${frames}" workload block_frames)
    json_expect(NUMBER "${blocks}" workload requested_blocks)
    json_expect(NUMBER "${blocks}" workload measured_blocks)
    json_expect(NUMBER "${keys}" workload selected_key_count)
    json_expect(NUMBER "${warmup}" workload requested_warmup_blocks)
    json_expect(NUMBER "${warmup}" workload completed_warmup_blocks)
    json_expect(NUMBER 0.5 workload initial_normalized_gain)
    json_expect(BOOLEAN OFF workload initial_sustain)

    math(EXPR interval "(16000 + ${frames} - 1) / ${frames}")
    math(EXPR triggers "(${blocks} - 1) / ${interval} + 1")
    math(EXPR notes "${keys} * ${triggers}")
    math(EXPR samples "${blocks} * ${frames}")
    set(points 0)
    set(owners "${keys}")
    if("${workload}" STREQUAL "pedal")
        math(EXPR notes "${notes} * 2")
        set(owners 0)
    endif()
    if(NOT "${workload}" STREQUAL "held")
        set(points "${samples}")
    endif()
    json_expect(NUMBER "${interval}" workload retrigger_interval_blocks)
    json_expect(NUMBER "${notes}" workload offered_note_events)
    json_expect(NUMBER "${points}" workload offered_parameter_points)
    json_expect(NUMBER "${notes}" integrity note_getter_reads)
    json_expect(NUMBER "${points}" integrity parameter_point_getter_reads)
    json_expect(NUMBER "${samples}" integrity frame_cursor)
    json_expect(NUMBER "${owners}" integrity active_note_owners)
    json_expect(NUMBER "${owners}" integrity expected_note_owners)
    json_expect(NUMBER "${blocks}" integrity successful_callbacks)
    json_expect(NUMBER 0 integrity failed_callbacks)
    json_expect(NUMBER 0 integrity last_result_code)
    foreach(flag IN ITEMS warmup_success finite_output_and_checksum stereo_equal
            silence_flags_correct output_presence_correct)
        json_expect(BOOLEAN ON integrity "${flag}")
    endforeach()
    json_read(nonzero NUMBER integrity nonzero_channel_samples)
    math(EXPR channel_samples "2 * ${samples}")
    if(nonzero LESS 0 OR nonzero GREATER channel_samples)
        message(FATAL_ERROR "Nonzero sample count outside measured output")
    endif()
    json_read(checksum NUMBER integrity checksum_sum_squares)
    json_read(peak NUMBER integrity peak_abs_digital_output)
    if(keys EQUAL 0)
        json_expect(BOOLEAN OFF integrity nonzero_output_expected)
        json_expect(NUMBER 0 integrity nonzero_channel_samples)
        json_expect(NUMBER 0 integrity checksum_sum_squares)
        json_expect(NUMBER 0 integrity peak_abs_digital_output)
    else()
        json_expect(BOOLEAN ON integrity nonzero_output_expected)
        if(NOT nonzero GREATER 0 OR NOT checksum GREATER 0 OR NOT peak GREATER 0)
            message(FATAL_ERROR "Expected ringing output is absent")
        endif()
    endif()
    json_read(hash STRING integrity output_fnv1a64)
    string(LENGTH "${hash}" hash_length)
    if(NOT hash_length EQUAL 16 OR NOT hash MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Malformed output fingerprint")
    endif()
    json_expect(STRING "std::chrono::steady_clock" timing clock)
    json_expect(STRING "nearest rank, one-based ceil(N*p/100)" timing percentile_rule)
    check_summary(${blocks} ${frames})
    set("${fingerprint}" "${hash}" PARENT_SCOPE)
    math(EXPR successful_cases "${successful_cases} + 1")
    set(successful_cases "${successful_cases}" PARENT_SCOPE)
endfunction()

foreach(format IN ITEMS 32 64)
    foreach(workload IN ITEMS held pedal gain)
        run_case(cold "${workload}" "${format}" 7 64 3 0)
        run_case(warm "${workload}" "${format}" 7 64 3 4)
        if(NOT "${cold}" STREQUAL "${warm}")
            message(FATAL_ERROR "Warmup changed measured ${workload}/${format} output")
        endif()
        # Five large blocks cross the independent two-block retrigger period.
        run_case(retriggered "${workload}" "${format}" 5 8192 3 2)
    endforeach()
    run_case(silent "gain" "${format}" 101 64 0 2)
    run_case(one_frame "held" "${format}" 1 1 73 0)
endforeach()

function(expect_rejected)
    execute_process(COMMAND "${BENCHMARK}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "2" OR NOT "${output}" STREQUAL ""
            OR NOT diagnostic MATCHES "^rhodes_vst3_benchmark:")
        message(FATAL_ERROR "Invalid arguments [${ARGN}] did not reject cleanly: ${result}: ${diagnostic}")
    endif()
    math(EXPR rejected_cases "${rejected_cases} + 1")
    set(rejected_cases "${rejected_cases}" PARENT_SCOPE)
endfunction()

expect_rejected(--blocks 0)
expect_rejected(--blocks 1000001)
expect_rejected(--blocks -1)
expect_rejected(--blocks 1junk)
expect_rejected(--blocks)
expect_rejected(--block-size 0)
expect_rejected(--block-size 8193)
expect_rejected(--block-size nan)
expect_rejected(--sample-rate 31999)
expect_rejected(--sample-rate 192001)
expect_rejected(--sample-rate nan)
expect_rejected(--sample-rate 48000.5)
expect_rejected(--active-keys 74)
expect_rejected(--active-keys -1)
expect_rejected(--warmup-blocks 10001)
expect_rejected(--warmup-blocks -1)
expect_rejected(--sample-format 16)
expect_rejected(--sample-format 128)
expect_rejected(--workload unknown)
expect_rejected(--unknown 1)
expect_rejected(--help --blocks 1)
string(ASCII 31 control_character)
expect_rejected(--machine "bad${control_character}label")
string(REPEAT "a" 129 long_label)
expect_rejected(--machine "${long_label}")

execute_process(COMMAND "${BENCHMARK}" --help RESULT_VARIABLE result
    OUTPUT_VARIABLE help ERROR_VARIABLE diagnostic TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL ""
        OR NOT help MATCHES "Usage: rhodes_vst3_benchmark")
    message(FATAL_ERROR "Benchmark help failed")
endif()

message(STATUS "VST3 benchmark: ${successful_cases} JSON cases, ${rejected_cases} invalid-input cases and help passed")
