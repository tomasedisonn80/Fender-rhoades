function(check_relaunch fixture action_time end_time)
    run_fixture("${fixture}" "${end_time}" "${end_time}")
    json_length(count runs 0 relaunch_snapshots)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${fixture}: expected one complete action snapshot")
    endif()
    set(path runs 0 relaunch_snapshots 0)
    json_expect(BOOLEAN ON ${path} success)
    json_expect(NUMBER 0 ${path} failure_code)
    json_expect(NUMBER "${action_time}" ${path} time_s)
    json_expect(NUMBER "${action_time}" ${path} before time_s)
    json_expect(NUMBER "${action_time}" ${path} after time_s)
    json_expect(NUMBER 1 ${path} requested_velocity_m_per_s)
    json_expect(NUMBER 1 ${path} after hammer_velocity_m_per_s)
    foreach(field IN ITEMS q_m v_m_per_s)
        json_read(before ARRAY ${path} before "${field}")
        json_read(after ARRAY ${path} after "${field}")
        json_length(count ${path} before "${field}")
        if(NOT count EQUAL 2 OR NOT "${before}" STREQUAL "${after}")
            message(FATAL_ERROR "${fixture}: action changed ${field}")
        endif()
    endforeach()
    foreach(field IN ITEMS time_s hammer_position_m hammer_impulse_ns damper_impulse_ns
            modal_loss_j hammer_loss_j damper_loss_j actuator_work_j pickup_voltage_v)
        json_read(before NUMBER ${path} before "${field}")
        json_expect(NUMBER "${before}" ${path} after "${field}")
    endforeach()
    # Each fixture has exactly one action. With its initial work exactly zero,
    # the exported action delta must equal the after, final and event ledgers.
    json_expect(NUMBER 0 ${path} before launch_work_j)
    json_read(work NUMBER ${path} work_j)
    json_range(0 0.004 ${path} work_j)
    json_expect(NUMBER "${work}" ${path} after launch_work_j)
    json_expect(NUMBER "${work}" runs 0 samples "${last_sample}" launch_work_j)
    if(action_time EQUAL 0)
        # .5 * .008 * (1^2 - (-.3)^2) = .00364 J independently.
        json_expect(NUMBER 0.00008 ${path} before q_m 0)
        json_expect(NUMBER -0.00002 ${path} before q_m 1)
        json_expect(NUMBER -0.3 ${path} before hammer_velocity_m_per_s)
        json_range(0.00363999999999 0.00364000000001 ${path} work_j)
    else()
        # The evolved fixture started at rest; this snapshot must contain its
        # already moving resonator, rather than reconstructed initial state.
        json_range(0.001 0.002 ${path} before q_m 0)
    endif()
    json_length(count runs 0 events)
    math(EXPR last "${count} - 1")
    set(relaunches 0)
    foreach(index RANGE 0 ${last})
        json_read(kind STRING runs 0 events "${index}" kind)
        if(kind STREQUAL "relaunch")
            math(EXPR relaunches "${relaunches} + 1")
            json_expect(NUMBER "${action_time}" runs 0 events "${index}" time_s)
            json_expect(NUMBER "${work}" runs 0 events "${index}" work_j)
        endif()
    endforeach()
    if(NOT relaunches EQUAL 1)
        message(FATAL_ERROR "${fixture}: action and event records disagree")
    endif()
endfunction()

check_relaunch(relaunch_phase_plus 0 0.002)
check_relaunch(relaunch_phase_minus 0 0.002)
check_relaunch(evolved_relaunch 0.0037 0.020)

function(expect_rejected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
    if(NOT "${result}" STREQUAL "1" OR NOT "${output}" STREQUAL ""
            OR NOT diagnostic MATCHES "^Contact reference error:")
        message(FATAL_ERROR "Invalid arguments [${ARGN}] did not reject cleanly: ${result}: ${diagnostic}")
    endif()
endfunction()

