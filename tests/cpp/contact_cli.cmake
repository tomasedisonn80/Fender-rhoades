cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED PROGRAM OR NOT IS_ABSOLUTE "${PROGRAM}"
        OR NOT EXISTS "${PROGRAM}" OR IS_DIRECTORY "${PROGRAM}")
    message(FATAL_ERROR "PROGRAM must name an existing absolute executable path")
endif()

# Black-box export checks. The C++ acceptance suite and optional independent
# auditor own the full numerical/refinement gates; this script needs no SciPy.
function(json_read output expected_type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${contact_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND"
            OR NOT "${actual_type}" STREQUAL "${expected_type}")
        message(FATAL_ERROR "JSON [${ARGN}] must be ${expected_type}: ${error}")
    endif()
    string(JSON value ERROR_VARIABLE error GET "${contact_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Cannot read JSON [${ARGN}]: ${error}")
    endif()
    if("${expected_type}" STREQUAL "NUMBER")
        string(TOLOWER "${value}" lowered)
        if(lowered MATCHES "nan|inf")
            message(FATAL_ERROR "Nonfinite JSON number [${ARGN}]")
        endif()
    endif()
    set("${output}" "${value}" PARENT_SCOPE)
endfunction()

function(json_expect expected_type expected)
    json_read(actual "${expected_type}" ${ARGN})
    if("${expected_type}" STREQUAL "NUMBER")
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "JSON [${ARGN}]: expected ${expected}, got ${actual}")
        endif()
    elseif(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected JSON value [${ARGN}]: ${actual}")
    endif()
endfunction()

function(json_range lower upper)
    json_read(actual NUMBER ${ARGN})
    if(actual LESS lower OR actual GREATER upper)
        message(FATAL_ERROR "JSON [${ARGN}]: ${actual} outside [${lower}, ${upper}]")
    endif()
endfunction()

function(json_length output)
    string(JSON count ERROR_VARIABLE error LENGTH "${contact_json}" ${ARGN})
    if(NOT "${error}" STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Cannot read JSON length [${ARGN}]: ${error}")
    endif()
    set("${output}" "${count}" PARENT_SCOPE)
endfunction()

function(run_fixture fixture end_lower end_upper)
    execute_process(COMMAND "${PROGRAM}" --fixture "${fixture}" --output-step 0.001
        RESULT_VARIABLE result OUTPUT_VARIABLE contact_json ERROR_VARIABLE diagnostic
        TIMEOUT 30)
    if(NOT "${result}" STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
        message(FATAL_ERROR "${fixture} failed: ${result}: ${diagnostic}")
    endif()
    json_read(root OBJECT)
    json_expect(NUMBER 1 schema_version)
    json_expect(STRING synthetic-contact-p1 model)
    json_read(runs ARRAY runs)
    json_length(count runs)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one exported run")
    endif()
    json_expect(STRING "${fixture}" runs 0 fixture)
    json_expect(BOOLEAN ON runs 0 success)
    json_expect(NUMBER 0 runs 0 failure_code)
    json_expect(NUMBER 0.001 runs 0 output_step_s)
    json_read(samples ARRAY runs 0 samples)
    json_length(count runs 0 samples)
    if(count LESS 2)
        message(FATAL_ERROR "Missing initial/final samples")
    endif()
    math(EXPR last "${count} - 1")
    json_expect(NUMBER 0 runs 0 samples 0 time_s)
    json_range("${end_lower}" "${end_upper}" runs 0 samples "${last}" time_s)
    json_read(actions ARRAY runs 0 relaunch_snapshots)
    json_read(events ARRAY runs 0 events)
    json_read(diagnostics OBJECT runs 0 diagnostics)
    json_range(1 100000 runs 0 diagnostics accepted_steps)
    json_range(0 1e-7 runs 0 diagnostics max_abs_cumulative_residual_j)
    json_range(0 1e-7 runs 0 diagnostics sum_abs_interval_residual_j)
    json_range(0 1000000000 runs 0 diagnostics analytic_free_evaluations)
    json_read(scope STRING runs 0 diagnostics sampled_maxima scope)
    if(NOT scope MATCHES "not continuous-time extrema")
        message(FATAL_ERROR "Sampled maxima must explicitly disclaim continuous-time extrema")
    endif()
    foreach(contact IN ITEMS hammer damper)
        foreach(quantity IN ITEMS compression force)
            if(quantity STREQUAL "compression")
                set(unit m)
            else()
                set(unit n)
            endif()
            json_range(0 100000000 runs 0 diagnostics sampled_maxima "${contact}_${quantity}_${unit}")
            json_range(0 "${end_upper}" runs 0 diagnostics sampled_maxima "${contact}_${quantity}_time_s")
        endforeach()
    endforeach()
    set(contact_json "${contact_json}" PARENT_SCOPE)
    set(last_sample "${last}" PARENT_SCOPE)
endfunction()

