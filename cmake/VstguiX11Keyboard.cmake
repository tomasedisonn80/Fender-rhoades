# Adapt the pinned backend's omitted Mod4 keyboard mapping in the build copy.
# The verified external SDK remains unchanged; see docs/DEPENDENCIES.md.
function(rhodes_patch_vstgui_x11_keyboard)
    get_target_property(vstgui_dir vstgui SOURCE_DIR)
    set(original "${vstgui_dir}/platform/linux/x11platform.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
    file(READ "${original}" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    string(SHA256 original_hash "${contents}")
    if(NOT original_hash STREQUAL "7158057162bc716aeb52efc5e6744b9432ffb8b86e9e0a68895d9d340cc87bb3")
        message(FATAL_ERROR "Unexpected pinned VSTGUI X11 source; review local adaptation")
    endif()
    set(before "\t\tif (event.state & (XCB_MOD_MASK_1 | XCB_MOD_MASK_5))\n\t\t\tkeyEvent.modifiers.add (ModifierKey::Alt);")
    set(after "${before}\n\t\tif (event.state & XCB_MOD_MASK_4)\n\t\t\tkeyEvent.modifiers.add (ModifierKey::Super);")
    string(REPLACE "${before}" "${after}" patched "${contents}")
    string(SHA256 patched_hash "${patched}")
    if(NOT patched_hash STREQUAL "c186a90e423b3895347a676e07c6059accb3b9ab0c187a795d318a1f6af361be")
        message(FATAL_ERROR "VSTGUI X11 keyboard adaptation mismatch")
    endif()
    set(overlay_dir "${CMAKE_CURRENT_BINARY_DIR}/rhodes-vstgui-overlay")
    set(overlay "${overlay_dir}/x11platform.cpp")
    get_target_property(sources vstgui SOURCES)
    set(replacements 0)
    set(patched_sources)
    foreach(source IN LISTS sources)
        if(source STREQUAL "platform/linux/x11platform.cpp" OR source STREQUAL "${original}")
            list(APPEND patched_sources "${overlay}")
            math(EXPR replacements "${replacements} + 1")
        else()
            list(APPEND patched_sources "${source}")
        endif()
    endforeach()
    if(NOT replacements EQUAL 1)
        message(FATAL_ERROR "Expected exactly one pinned VSTGUI X11 source")
    endif()
    file(MAKE_DIRECTORY "${overlay_dir}")
    if(EXISTS "${overlay}")
        file(SHA256 "${overlay}" existing_hash)
    endif()
    if(NOT existing_hash STREQUAL patched_hash)
        file(WRITE "${overlay}" "${patched}")
    endif()
    set_property(TARGET vstgui PROPERTY SOURCES "${patched_sources}")
    set_source_files_properties("${overlay}" TARGET_DIRECTORY vstgui
        PROPERTIES INCLUDE_DIRECTORIES "${vstgui_dir}/platform/linux")
endfunction()
