# Make the pinned Win32 timer report successful scheduling in the build copy.
# The verified external SDK and its VSTGUI license header remain unchanged;
# source, newline and license provenance: docs/agents/reports/photo-continuation-20261124/w2-033.md.
function(rhodes_patch_vstgui_win32_timer)
    get_target_property(vstgui_dir vstgui SOURCE_DIR)
    set(original "${vstgui_dir}/platform/win32/wintimer.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
    file(READ "${original}" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    string(SHA256 original_hash "${contents}")
    if(NOT original_hash STREQUAL "8fd9713b0adbdb8c3c5e049a87aaf2bab6d14e2e43f54293b10854942f62dadc")
        message(FATAL_ERROR "Unexpected pinned VSTGUI Win32 timer source; review local adaptation")
    endif()
    set(before "\t\tWinTimerPrivate::gTimerMap.emplace (static_cast<UINT_PTR> (timer), callback);\n\n\treturn false;")
    set(after "\t\tWinTimerPrivate::gTimerMap.emplace (static_cast<UINT_PTR> (timer), callback);\n\n\treturn timer != 0;")
    string(REPLACE "${before}" "${after}" patched "${contents}")
    string(SHA256 patched_hash "${patched}")
    if(NOT patched_hash STREQUAL "2d7fbc18625171a4edd7861118b821d70b68f5eae520b53704c5d6b957df0191")
        message(FATAL_ERROR "VSTGUI Win32 timer adaptation mismatch")
    endif()
    set(overlay_dir "${CMAKE_CURRENT_BINARY_DIR}/rhodes-vstgui-overlay")
    set(overlay "${overlay_dir}/wintimer.cpp")
    get_target_property(sources vstgui SOURCES)
    set(replacements 0)
    set(patched_sources)
    foreach(source IN LISTS sources)
        if(source STREQUAL "platform/win32/wintimer.cpp" OR source STREQUAL "${original}")
            list(APPEND patched_sources "${overlay}")
            math(EXPR replacements "${replacements} + 1")
        else()
            list(APPEND patched_sources "${source}")
        endif()
    endforeach()
    if(NOT replacements EQUAL 1)
        message(FATAL_ERROR "Expected exactly one pinned VSTGUI Win32 timer source")
    endif()
    file(MAKE_DIRECTORY "${overlay_dir}")
    if(EXISTS "${overlay}")
        file(SHA256 "${overlay}" existing_hash)
    endif()
    if(NOT existing_hash STREQUAL patched_hash)
        file(WRITE "${overlay}" "${patched}")
    endif()
    set_property(TARGET vstgui PROPERTY SOURCES "${patched_sources}")
    set_source_files_properties("${overlay}" TARGET_DIRECTORY vstgui
        PROPERTIES INCLUDE_DIRECTORIES "${vstgui_dir}/platform/win32")
endfunction()
